{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "recruitment/wallet-ledger-api",
    "type": "project",
    "description": "Wallet Ledger API: concurrent-safe credit/debit/balance ledger on PostgreSQL.",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-pdo_pgsql": "*",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.6"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
